# ============================================================
# Git Ignore for FastAPI / Python Backend
# ============================================================

# Environment variables & secrets
.env
.env.*
!.env.example

# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.pyc

# Virtual environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Logs
*.log
logs/

# Local databases
*.db
*.sqlite
*.sqlite3

# ChromaDB / vector database
chroma_db/
**/chroma_db/

# Uploaded user files
uploads/
**/uploads/

# Python tooling & test cache
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# IDE & Editor files
.vscode/
.idea/
*.sublime-workspace
*.sublime-project

# OS generated files
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
