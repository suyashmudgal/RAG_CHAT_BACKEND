# ============================================================
# DocChat AI — Environment Variables
# ============================================================
# Copy this file to .env and fill in the required values.

# ── Groq API (REQUIRED for chat) ──────────────────────────────
# Get a free key at: https://console.groq.com/keys
GROQ_API_KEY=

# Groq model to use (optional — has a sensible default)
GROQ_MODEL=openai/gpt-oss-120b

# ── Embedding model (local, free — no key needed) ─────────────
# Downloaded automatically on first run (~90 MB)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── ChromaDB persistence directory ────────────────────────────
CHROMA_PERSIST_DIR=./chroma_db

# ── File upload settings ──────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50

# ── Text chunking ────────────────────────────────────────────
CHUNK_SIZE=800
CHUNK_OVERLAP=200

# ── RAG retrieval & Citation precision ───────────────────────
RETRIEVAL_TOP_K=6
SIMILARITY_THRESHOLD=0.20
CITATION_MARGIN=0.25
MAX_CITATIONS=4

# ── Authentication (JWT) ─────────────────────────────────────
# Generate a strong random secret for production
JWT_SECRET_KEY=change-me-to-a-random-secret
JWT_EXPIRY_HOURS=72
AUTH_DB_PATH=./auth.db

# ── Google OAuth ─────────────────────────────────────────────
# Obtain from Google Cloud Console > APIs & Services > Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
FRONTEND_URL=http://localhost:5173

# ── CORS (comma-separated origins) ───────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Database (Supabase PostgreSQL) ───────────────────────────
DATABASE_URL=your_postgresql_connection_string

# ── Supabase Storage ──────────────────────────────────────────
# Storage URL (e.g. https://<project-ref>.supabase.co)
SUPABASE_URL=
# Service Role Key (Found in Supabase Dashboard > Settings > API > Project API keys > service_role)
# CRITICAL: Keep secret! Never expose to browser or frontend.
SUPABASE_SERVICE_ROLE_KEY=
# Private bucket for user documents (default: documents)
SUPABASE_STORAGE_BUCKET=documents
